# From `supabase start` output
SUPABASE_URL=http://127.0.0.1:54321
# Service role key -- server-side only, never ship this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001

# Phase 2: Fast Pass. Get these from your own Stripe account (test mode
# is fine for development) -- https://dashboard.stripe.com/test/apikeys
# for the secret key, and https://dashboard.stripe.com/test/webhooks for
# the webhook signing secret once you've registered this API's
# /webhooks/stripe endpoint (use the Stripe CLI's `stripe listen --forward-to`
# for local development). STRIPE_MONTHLY_PRICE_ID is the Price ID of a
# recurring monthly Price you create for the Fast Pass subscription
# product.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=

# This API's own publicly reachable URL -- encoded into every Fast Pass
# QR code so a bouncer's camera app can open it. In local dev this needs
# to be a tunnel (e.g. ngrok) or your machine's LAN IP, not localhost,
# since it must be reachable from a phone that isn't your dev machine.
PUBLIC_API_URL=http://127.0.0.1:3001

# The mobile app's own deep-link base (or a placeholder web page) that
# Stripe Checkout redirects back to after payment.
APP_BASE_URL=http://127.0.0.1:3001
